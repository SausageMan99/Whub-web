# Web / Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker / VPS
SUPABASE_URL=
SUPABASE_ANON_KEY=
WORKER_DATABASE_URL=postgresql://whub_worker:<password>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true
WORKER_NAME=whub-cv-worker-01
POLL_INTERVAL_SECONDS=10
MAX_ATTEMPTS=3

CV_SOURCES_BUCKET=cv-sources
CV_RENDERER_INPUTS_BUCKET=cv-renderer-inputs
CV_FINALS_BUCKET=cv-finals
CV_ARTIFACTS_BUCKET=cv-artifacts

# Structuring backend: openrouter (direct API, strict JSON schema) | hermes (legacy CLI)
WHUB_LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
# Model choice and measurements: ops/model-bakeoff-2026-11-02.md
WHUB_PRIMARY_MODEL=google/gemini-2.5-flash
WHUB_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# CVs up to this length go to the model in one call (block splitting cut experiences apart)
WHUB_MEDIUM_CV_SINGLE_PASS_THRESHOLD=40000
# true = zero-data-retention endpoints only; Gemini 2.5 Flash has none, keep false with it
WHUB_LLM_ZERO_DATA_RETENTION=false
WHUB_LLM_MAX_OUTPUT_TOKENS=32000
WHUB_LONG_CV_BLOCK_PARALLELISM=4

HERMES_CLI_PATH=hermes
HERMES_PROFILE=default
WHUB_RENDERER_PATH=/root/.hermes/scripts/whub_cv_renderer.py
WHUB_ASSETS_DIR=/root/.hermes/image_cache
WHUB_FONTS_DIR=/tmp/poppins_full
TMP_DIR=/tmp/whub-cv-factory
LOG_LEVEL=INFO

# MVP whitelist: add 4-5 W hub users in Supabase allowed_users table, not here.
